# Source-only private repository. Everything is excluded unless explicitly allowed.
/*
!/.gitignore
!/*.py
!/README.md
!/PROJECT.md
!/BOARD.md
!/HANDOFF.md
!/CLIENT_PLAYBACK.md
!/THIRD_PARTY_NOTICES.md
!/toolchain-lock.json
!/requirements-breeze.lock.txt
!/pronunciation-overrides.json
!/rights-attestation.example.json
!/prep/
/prep/*
!/prep/voice_lab.py
!/prep/breeze_worker.py
!/prep/expression_support.py
!/prep/assets.json
!/prep/cannedChatItems.cs
!/workflow/
/workflow/*
!/workflow/tribes2_sample_engine.ipynb
!/workflow/kernel-metadata.json
!/licenses/
/licenses/*
!/licenses/Breeze-TTS-2-LICENSE.txt
!/licenses/Breeze-NOTICE.txt
!/licenses/CMUDICT-LICENSE.txt

# Never relax these for source publication or handoff.
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/rights-attestation.json
**/companion.json
**/state.json
**/*.wav
**/*.WAV
**/*.safetensors
**/*.pt
**/*.onnx
**/*.tar.gz
**/*.zip
